[build-system]
requires = ["setuptools>=64,<77", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "mokda-xponge"
version = "@VERSION@"
description = "Compatibility package for Xponge"
readme = "README.md"
requires-python = ">=3.10"
authors = [
    { name = "Yijie Xia", email = "yijiexia@pku.edu.cn" },
]
dependencies = [
    "Xponge==@VERSION@",
]
urls = { Homepage = "https://gitee.com/gao_hyp_xyj_admin/xponge" }
classifiers = [
    "Programming Language :: Python :: 3 :: Only",
    "Development Status :: 5 - Production/Stable",
    "Operating System :: OS Independent",
]

[tool.setuptools]
packages = []
